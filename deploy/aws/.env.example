# Copy to .env for local docker run against Aurora or Supabase (do not commit .env)
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# DB_PROVIDER=aurora (default if unset)
DB_PROVIDER=aurora
AWS_REGION=eu-north-1
SPRING_DATASOURCE_URL=jdbc:aws-wrapper:postgresql://your-cluster-host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
# No password — IAM auth via AWS credential chain (mount ~/.aws or use ECS task role)

# --- OR, to point at Supabase instead, comment the aurora block above and uncomment this: ---
# DB_PROVIDER=supabase
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<from Supabase Dashboard -> Settings -> Database>
