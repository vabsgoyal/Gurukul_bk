# WA-AKG WhatsApp gateway (OTP delivery for Gurukul).
[Unit]
Description=WA-AKG WhatsApp Gateway (OTP delivery for Gurukul)
Documentation=https://github.com/vabsgoyal/Gurukul_bk/tree/main/whatsapp-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gurukul
Group=gurukul
WorkingDirectory=/opt/whatsapp-gateway
EnvironmentFile=/opt/whatsapp-gateway/.env
Environment=NODE_ENV=production
# tsx directly rather than "npm run start" (npx tsx ...): skips two npm wrapper processes (~140 MB) on a 2 GB box.
ExecStart=/opt/whatsapp-gateway/node_modules/.bin/tsx src/server/index.ts
# always, not on-failure: a clean exit (code 0) must also bring OTP delivery back
Restart=always
RestartSec=5
MemoryHigh=640M
MemoryMax=900M

[Install]
WantedBy=multi-user.target
