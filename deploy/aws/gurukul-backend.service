[Unit]
Description=Gurukul Backend (JAR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/gurukul
EnvironmentFile=/etc/gurukul/backend.env
# t3.small (2 GB RAM + 2 GB swap): heap capped at 45% so the WhatsApp gateway and the OS fit alongside.
ExecStart=/usr/bin/java -XX:+UseContainerSupport -XX:MaxRAMPercentage=45 -jar /opt/gurukul/gurukul-backend.jar
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
