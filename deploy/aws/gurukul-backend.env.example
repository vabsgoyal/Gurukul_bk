SPRING_PROFILES_ACTIVE=prod
PORT=8080
AWS_REGION=eu-north-1

# --- Database: DB_PROVIDER picks between the two DataSource beans in
# com.gurukul.config.DataSourceConfig.
#
# IMPORTANT: as of the DB_PROVIDER GitHub Secret wiring in .github/workflows/deploy.yml, the 4
# lines below are ONLY a one-time bootstrap for a brand-new instance before its first deploy -
# every push to main overwrites DB_PROVIDER / SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD in
# /etc/gurukul/backend.env from the matching GitHub repo secrets, ignoring whatever's here.
# Update the GitHub Secrets to actually change these, not this file.

# DB_PROVIDER=supabase (default if unset) - Supabase-managed Postgres, username/password over TLS.
DB_PROVIDER=supabase
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<from Supabase Dashboard -> Settings -> Database>

# DB_PROVIDER=aurora - AWS Aurora Postgres, IAM auth, no password.
# DB_PROVIDER=aurora
# SPRING_DATASOURCE_URL=jdbc:aws-wrapper:postgresql://gurukul.cluster-cro4soma8nh2.eu-north-1.rds.amazonaws.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres

# Set by CI deploy — full ECR URI with git sha tag
GURUKUL_IMAGE=916169432799.dkr.ecr.eu-north-1.amazonaws.com/gurukul-backend:latest
